    def get_forums_menu(self):
        forums = self.db.get_all_forums()
        
        text = "📋 <b>论坛版块订阅</b>\n\n选择一个论坛管理其版块订阅：\n"
        
        keyboard = {"inline_keyboard": []}
        for forum in forums:
            cats = self.db.get_forum_categories(forum['id'])
            subscribed = sum(1 for c in cats if c['enabled'])
            total = len(cats)
            keyboard["inline_keyboard"].append([{
                "text": f"📌 {forum['name']} ({subscribed}/{total})",
                "callback_data": f"forum_categories_{forum['id']}"
            }])
        
        keyboard["inline_keyboard"].append([
            {"text": "🔙 返回源管理", "callback_data": "menu_sources"}
        ])
        return text, keyboard
    
    def get_forum_categories_menu(self, forum_id):
        cursor = self.db.conn.cursor()
        cursor.execute("SELECT name FROM forums WHERE id = ?", (forum_id,))
        forum = cursor.fetchone()
        
        if not forum:
            return None, None
        
        categories = self.db.get_forum_categories(forum_id)
        
        text = f"📌 <b>{forum['name']} 版块订阅</b>\n\n点击版块切换订阅，点击⚙️维护：\n"
        
        keyboard = {"inline_keyboard": []}
        for cat in categories:
            status = "🟢" if cat['enabled'] else "🔴"
            timeout_str = f" {cat['custom_timeout']}s" if 'custom_timeout' in cat.keys() and cat['custom_timeout'] else ""
            interval_str = f" {cat['custom_interval']}s" if 'custom_interval' in cat.keys() and cat['custom_interval'] else ""
            note = ""
            if timeout_str or interval_str:
                note = f" [{timeout_str}{interval_str}]"
            
            keyboard["inline_keyboard"].append([
                {
                    "text": f"{status} {cat['category_name']}{note}",
                    "callback_data": f"toggle_forum_category_{cat['id']}"
                },
                {
                    "text": "⚙️",
                    "callback_data": f"maintain_category_{cat['id']}"
                }
            ])
        
        keyboard["inline_keyboard"].extend([
            [{"text": "✅ 全部订阅", "callback_data": f"subscribe_all_forum_{forum_id}"},
             {"text": "❌ 全部取消", "callback_data": f"unsubscribe_all_forum_{forum_id}"}],
            [{"text": "➕ 添加版块", "callback_data": f"add_category_{forum_id}"}],
            [{"text": "🔙 返回论坛列表", "callback_data": "menu_forums"}]
        ])
        return text, keyboard
    
    def get_category_maintain_menu(self, category_id):
        cat = self.db.get_category(category_id)
        if not cat:
            return None, None
        
        custom_timeout = cat['custom_timeout'] if 'custom_timeout' in cat.keys() else None
        custom_interval = cat['custom_interval'] if 'custom_interval' in cat.keys() else None
        custom_url = cat['custom_url'] if 'custom_url' in cat.keys() else None
        
        text = f"""⚙️ <b>版块维护 - {cat['forum_name']} {cat['category_name']}</b>

📌 版块名称: {cat['category_name']}
🔑 版块标识: {cat['category_key']}
🔗 RSS地址: {custom_url or '自动生成'}
⏱ 检查间隔: {custom_interval or '默认(60s)'}
⏰ 超时时间: {custom_timeout or '默认(30s)'}
🟢 状态: {'已订阅' if cat['enabled'] else '未订阅'}"""

        keyboard = {
            "inline_keyboard": [
                [{"text": "✏️ 修改名称", "callback_data": f"edit_cat_name_{category_id}"}],
                [{"text": "🔑 修改标识", "callback_data": f"edit_cat_key_{category_id}"}],
                [{"text": "🔗 自定义URL", "callback_data": f"edit_cat_url_{category_id}"}],
                [{"text": "⏱ 设置间隔", "callback_data": f"edit_cat_interval_{category_id}"}],
                [{"text": "⏰ 设置超时", "callback_data": f"edit_cat_timeout_{category_id}"}],
                [{"text": "🔄 重置为默认", "callback_data": f"reset_category_{category_id}"}],
                [{"text": "🗑 删除此版块", "callback_data": f"delete_category_{category_id}"}],
                [{"text": "🔙 返回", "callback_data": f"forum_categories_{cat['forum_id']}"}]
            ]
        }
        return text, keyboard
    
    def get_delete_source_menu(self):
        sources = self.db.get_all_sources()
        text = "🗑 <b>选择要删除的RSS源</b>"
        keyboard = {"inline_keyboard": []}
        for src in sources:
            keyboard["inline_keyboard"].append([{
                "text": f"❌ {src['name']}",
                "callback_data": f"delete_source_{src['id']}"
            }])
        keyboard["inline_keyboard"].append([{"text": "🔙 返回", "callback_data": "menu_sources"}])
        return text, keyboard
    
    def get_pause_menu(self):
