    def get_filter_menu(self, keyword_id, keyword):
        filters = self.db.get_all_filters(keyword_id)
        
        text = f"""🔍 <b>过滤规则管理</b>

关键词: <b>{keyword}</b>

<b>当前规则</b>"""
        
