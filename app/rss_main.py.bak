                last_check = last_check[5:16]
            timeout_str = f" | 超时: {src['timeout'] if 'timeout' in src.keys() else 30}s" if 'timeout' in src.keys() else ""
            text += f"{status} <b>{src['name']}</b>\n"
            text += f"   └ 间隔: {src['check_interval']}s{timeout_str} | 上次: {last_check}\n\n"
        
        keyboard = {"inline_keyboard": []}
        row = []
        for src in sources[:6]:
            row.append({
