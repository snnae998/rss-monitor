                 {"text": "🔛 切换状态", "callback_data": "toggle_keyword_menu"}],
                [{"text": "➖ 删除关键词", "callback_data": "delete_keyword_menu"}],
                [{"text": "🔙 返回主菜单", "callback_data": "back_to_menu"}]
            ])
