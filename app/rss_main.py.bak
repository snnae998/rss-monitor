            [{"text": "➕ 添加RSS源", "callback_data": "add_source"}],
            [{"text": "🗑 删除RSS源", "callback_data": "delete_source_menu"}],
            [{"text": "🔙 返回主菜单", "callback_data": "back_to_menu"}]
        ])
